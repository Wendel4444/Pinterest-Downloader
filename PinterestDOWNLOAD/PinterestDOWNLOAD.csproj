<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PinterestDOWNLOAD</RootNamespace>
    <AssemblyTitle>Pinterest Downloader</AssemblyTitle>
    <Version>0.2.0</Version>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- O ChromeDriver e resolvido automaticamente pelo Selenium Manager
         (Selenium 4.6+), casando com a versao do Chrome instalado.
         Por isso NAO fixamos mais o pacote Selenium.WebDriver.ChromeDriver. -->
    <PackageReference Include="Selenium.WebDriver" Version="4.47.0" />
  </ItemGroup>

</Project>
